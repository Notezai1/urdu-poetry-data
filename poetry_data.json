  "poetry": [
    {
      "id": 1794497893022,
      "category": "اسلامی",
      "text": "یہ مسجد بھی عجیب جگہ ہے ناں کہ جہاں امیر اور غریب دونوں ربّ سے بھیک مانگتے ہوئے نظر آتے ہیں",
      "author": "صفیان",
      "date": "2026-11-12T20:38:13Z"
    },
    {
      "id": "p_1794497664070",
      "category": "اسلامی",
      "text": "یوں غریب کہہ کر خود کی توہین نا کر اے بندے غریب تو وہ لوگ ہیں جن کے پاس ایمان نہیں",
      "author": "",
      "date": "2026-11-12"
    },
    {
      "id": "p1",
      "category": "محبت",
      "text": "تم تکلف کو بھی اخلاص سمجھتے ہو فراز\nدوست ہوتا نہیں ہر ہاتھ ملانے والا",
      "author": "احمد فراز",
      "date": "2026-11-12"
    }
  ]
}